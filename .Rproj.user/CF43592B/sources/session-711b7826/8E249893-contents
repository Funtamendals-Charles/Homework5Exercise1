```{r}
#Step 3: Clean the data
#Create a copy of the stacked data called all_data_clean
all_data_clean = all_data
#Convert the Rank column to integer. We use the sub function which using a regular expression, converts the suffix portion of each rank value into the empty string. This leaves just the numeric portion. From there we convert the numeric string into a proper integer. 
all_data_clean$Rank = as.integer(sub("(st|nd|rd|th)$", "", all_data$Rank))
#We get a warning about a NA value appearing in our Rank column. 
#Checking our pre-cleaned data, we see that Sudan in 2012 got a rank of "n/r" which becomes NA in our cleaned data set. 
all_data[is.na(all_data_clean$Rank),]
#View the cleaned data
all_data_clean
```

```{r}
#Step 4: Plot the Total across each Year on box plots

#Import library
library(ggplot2)
#Create ggplot object. It takes our data as input, then we tell it our x-axis is Year and y-axis is Total. We use factor to specify that Year is discrete. 
ggplot(all_data_clean, aes(x = factor(Year), y = Total)) +
  #Then we specify the visual geometry, in this case we want to draw box plots.
  geom_boxplot() +
  #Here we add labels, x-axis is Year, Y-axis is Total and title is Distribution of Total by Year
  labs(
    x = "Year",
    y = "Total",
    title = "Distribution of Total by Year"
  )
```

```{r}
#Step 5: Plot the C1, C2, C3 variables on histograms (only 2013, 2023)

#Filter the data to just the years 2013, 2023 and only the C1, C2, C3 columns
histogram_data = all_data_clean[all_data_clean$Year %in% c(2013, 2023),c("Country", "Year","C1: Security Apparatus", "C2: Factionalized Elites", "C3: Group Grievance")]

#Make the data long, which helps ggplot later on
long_data = reshape(
  histogram_data,
  varying = c("C1: Security Apparatus", "C2: Factionalized Elites", "C3: Group Grievance"),
  v.names = "Value",
  timevar = "Metric",
  times = c("C1: Security Apparatus", "C2: Factionalized Elites", "C3: Group Grievance"),
  idvar = c("Country", "Year"),
  direction = "long"
)

#Create the histograms
#First create ggplot object, we input our long data, and specify that our x-axis will hold our Values, the values of C1, C2, C3 across each Country and Year combination. 
ggplot(long_data, aes(x = Value)) +
  #We then  say we want to draw histograms, with bin widths of 1. We then fill each bar with blue and the edges black.
  geom_histogram(binwidth = 1, fill = "skyblue", color = "black") +
  #Then we use facet wrap which tells ggplot to make a plot for each pair of Year and Metric. We then let each plot of its own x-axis specified by scales = "free_x"
  facet_wrap(Year ~ Metric, scales = "free_x") +
  #Use a minimal theme
  theme_minimal() +
  #Add labels
  labs(
    x = "Value",
    y = "Count",
    title = "Histograms of C1, C2, C3 Metrics in 2013 and 2023"
  )


```