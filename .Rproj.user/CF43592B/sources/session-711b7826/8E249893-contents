```{r}
#Step 1: Create helper functions for loading data from Github

#Create function to load data into a data frame from Github URL. 
#Function load_data takes in the Github url as input, temporary saves the .xlsx file and returns the data as a data frame. R needs a local path to read .xlsx files. The following function streamlines the process. 
load_data = function(url) {
  #We temporarily create a file path on our system, we specify that it will store a .xlsx file
  tmp = tempfile(fileext = ".xlsx")
  #Then we download the file from our Github URL and store it to our temp path. We specify "wb" for write and binary mode, best for Windows systems
  download.file(url, tmp, mode = "wb")
  #Finally we return the data frame that can now be read by read_excel. 
  return (read_excel(tmp))
}

#Create function to generate Github URL from year 
get_link = function(year) {
  link_start = "https://github.com/Funtamendals-Charles/Homework5Exercise1/raw/refs/heads/main/Data/fsi-"
  link_year = as.character(year)
  link_end = ".xlsx"
  return (paste0(link_start, link_year, link_end))
}

#Turn a data frame's Year column to integer type if not already
to_Int_Year = function(df) {
  #First checks if data frame is of POSIXct Date type 
  if (inherits(df$Year, "POSIXct")) {
    #Reformat the date type to just the year and then turn into a integer 
    df$Year = as.integer(format(df$Year, "%Y"))
  }
  #Then check if the data is of double type, if so just turn it into an integer
  else if (typeof(df$Year) == "double") {
    df$Year = as.integer(df$Year)
  }
  #If none of the above, we assume its an integer and return the data frame
  return (df)
}
```

```{r}
#Step 2: Load data and stack them vertically

#Generate a list of years that span the data (from 2006 to 2023)
data_years_list = as.list(2006:2023)
#Using get_link generate all needed Github links as a list (for data from 2006 to 2023)
data_URL_list = lapply(data_years_list, get_link)
#Using load_data load all data into a list of data frames, each element holding data for each year
data_frame_list_unfiltered = lapply(data_URL_list, load_data)
#Store the relevant columns as per the assignment instructions, this happens to be identical to the column names in the 2006 data set (first data set in data_frame_list_unfiltered). 
relevant_columns = names(data_frame_list_unfiltered[[1]])
#Filter all data frames by only relevant columns 
data_frame_list = lapply(data_frame_list_unfiltered, function(df) {return (df[,relevant_columns])})
#Convert all Year columns to integer using our helper function to_Int_Year
data_frame_list_int_years = lapply(data_frame_list, to_Int_Year)
#Stack all data frames vertically 
all_data = do.call(rbind, data_frame_list_int_years)
```
